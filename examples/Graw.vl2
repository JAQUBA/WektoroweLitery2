# Vector Letters 2 layout
version=1

[template inverter]
type=plate
width=200
height=40
offset_x=0
offset_y=4
text_height=12
condensation=150
thickness=1.44
frame=true

[template switch]
type=multiline
width=100
height=30
offset_x=0
thickness=0.96
frame=true
line1_offset_y=6
line1_text_height=8
line1_condensation=100
line2_offset_y=-6
line2_text_height=8
line2_condensation=100

[template pump]
type=plate
width=100
height=30
offset_x=0
offset_y=4
text_height=8
condensation=130
thickness=0.96
frame=true

[row]
inverter: FALOWNIK 1

[row]
inverter: FALOWNIK 2

[row]
switch: WYŁĄCZNIK | FALOWNIKA 1
switch: WYŁĄCZNIK | FALOWNIKA 2

[row]
pump: POMPA 1
pump: POMPA 2

[row]
pump: POMPA 3
pump: POMPA 4
