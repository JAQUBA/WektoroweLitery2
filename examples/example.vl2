# Vector Letters 2 layout
version=1

[template pump]
type=plate
width=100
height=30
offset_x=0
offset_y=4
text_height=8
condensation=100
thickness=0.96
frame=true

[template control]
type=multiline
width=80
height=25
offset_x=0
thickness=0.72
frame=true
line1_offset_y=5
line1_text_height=6
line1_condensation=90
line2_offset_y=-5
line2_text_height=6
line2_condensation=80

[template inverter]
type=plate
width=200
height=40
offset_x=0
offset_y=4
text_height=12
condensation=150
thickness=1.44
frame=true

[row]
pump: POMPA 1
pump: POMPA 2

[row]
pump: POMPA 3
pump: POMPA 4

[row]
control: STEROWANIE | ZDALNE
control: STEROWANIE | LOKALNE

[row]
inverter: FALOWNIK 1
